# .env.example
# Copy to .env.local for development. Set the same names in your hosting provider for staging and production.
# Never commit real values.

# Public site address, no trailing slash. Used for canonical URLs, sitemap, emails and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings > API). The anon key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Full database access; never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# Random string used to hash visitor IP addresses for spam control (e.g. `openssl rand -hex 32`).
IP_HASH_SALT=

# Transactional email via Resend (optional). Without these, notifications are recorded as "skipped" and forms still work.
RESEND_API_KEY=
EMAIL_FROM="Msendo Noble Homes <notifications@your-verified-domain.com>"

# Cloudflare Turnstile spam protection (optional). Leave both blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Protects /api/cron/daily (inspection reminders, cleanup). Vercel Cron sends it automatically when set.
CRON_SECRET=

# Set to true only on production to let search engines index the site.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Set to true to delete closed, converted and spam enquiries older than the retention period in site settings.
RETENTION_PURGE=false

# End-to-end tests against a staging deployment (optional).
E2E_BASE_URL=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
